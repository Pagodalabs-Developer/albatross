# Copy to .env.local and fill in. Never commit .env.local.
# Values below are local-development defaults; the PRODUCTION line under each
# shows what to set on the deploy host instead.
# --- MongoDB (see lib/db.ts) -------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=albatross
# PRODUCTION: MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# --- Admin login (see lib/auth.ts) -------------------------------------------
# Single admin account held in env vars — there is no users collection.
# Server-side sessions, not JWT: no signing secret is used anywhere.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# PRODUCTION: set a long random password. Do not ship "change-me".
# --- Public site URL ---------------------------------------------------------
# Resolves absolute OpenGraph/Twitter image URLs. If this stays on localhost in
# production, every social preview image points at an unreachable host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PRODUCTION: NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# --- Upload storage ----------------------------------------------------------
# "local" writes to public/uploads. Fine for development, but disk is
# ephemeral on Vercel, so uploads vanish on redeploy.
# "blob" uses Vercel Blob. On Vercel, BLOB_STORE_ID and VERCEL_OIDC_TOKEN are
# injected automatically once a Blob store is connected to the project.
# For local development against Blob: run `vercel env pull`, then set
# BLOB_STORE_ID, or a BLOB_READ_WRITE_TOKEN from the store's settings.
UPLOAD_STORAGE=blob
# PRODUCTION: UPLOAD_STORAGE=blob
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
